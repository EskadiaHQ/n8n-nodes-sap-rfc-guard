      "parameters": {
        "resource": "salesOrder",
        "operation": "getStatus",
        "salesDocumentId": "={{ $json.salesDocument }}",
        "correlationId": "={{ $json.correlationId }}",
        "limit": 50,
        "includeMetadata": true
      },
      "type": "n8n-nodes-sap-rfc-guard.sapRfcGuard",
