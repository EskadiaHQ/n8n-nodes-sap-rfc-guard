            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "e16f0491-5827-485d-ae16-a8bf83b824b7",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": "",
