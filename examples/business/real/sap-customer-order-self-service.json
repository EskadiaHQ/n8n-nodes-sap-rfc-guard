      "position": [300, 80],
      "id": "5dc7c096-fc11-4f5e-876d-602bd58c2bca",
      "name": "Read Authorized Sales Order Status",
      "credentials": {
        "sapRfcGuardApi": {
          "name": "REPLACE · REAL A4H 250 · Customer Safe Read Only"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const auth=$('Authorize Customer Scope').first().json;const rows=$input.all().map(i=>i.json);if(!rows.length||rows.some(r=>String(r.salesDocument||'').padStart(10,'0')!==auth.salesDocument))throw new Error('AUTHORIZED_SALES_DOCUMENT_READBACK_MISMATCH');const items=rows.map(r=>({item:String(r.itemNumber||'').padStart(6,'0'),material:r.material||r.materialLong||null,shortText:r.shortText||null,requestedQuantity:Number(r.requestedQuantity||0),confirmedQuantity:Number(r.confirmedQuantity||0),salesUnit:r.salesUnit||null,itemDeliveryStatus:r.itemDeliveryStatus||null,delivery:r.delivery||null,deliveredQuantity:Number(r.deliveredQuantity||0),requestedDeliveryDate:r.requestedDeliveryDate||null,deliveryDate:r.deliveryDate||null}));return [{json:{status:'AUTHORIZED_SAP_RESPONSE',salesDocument:auth.salesDocument,headerProcessingStatus:rows[0].headerProcessingStatus||null,headerDeliveryStatus:rows[0].headerDeliveryStatus||null,items,source:{system:'A4H',client:'250',operation:'getSalesOrderStatus',syntheticData:rows[0]._rfc?.syntheticData??null},audit:{channel:auth.channel,subjectRef:auth.subjectRef,customerAccount:auth.customerAccount,correlationId:auth.correlationId,executionId:String($execution.id),readAt:new Date().toISOString()}}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [580, 80],
