    {
      "parameters": {
        "content": "## Customer order self-service\n\nA trusted Teams or WhatsApp adapter authenticates the requester and supplies an opaque subject, customer account and allowlisted sales-document IDs. This workflow never derives authorization from message text. It reads real SAP status through RFC Guard and returns only customer-safe fields.\n\nKeep inactive until Header Auth, the channel adapter and positive/cross-customer negative tests are verified.",
        "width": 680,
        "height": 300,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-620, -360],
      "id": "f7f641c9-527c-4d3e-a712-e7a77ae93cf1",
      "name": "Identity and Data Contract"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sap-customer-order-query",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-520, 100],
      "id": "d9dd1138-7f1e-48e1-aa28-47002918eaf8",
      "name": "Authenticated Channel Request",
      "webhookId": "1bfbdf1c-e113-4cc2-af08-e8fe62f76b2d",
      "credentials": {
        "httpHeaderAuth": {
          "name": "REPLACE · Trusted Channel Adapter"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item=$input.first();const source=item.json?.body||item.json||{};const trusted=source.trustedContext||{};const request=source.request||{};const channel=String(trusted.channel||'').toLowerCase();const subject=String(trusted.authenticatedSubject||'').trim();const customerAccount=String(trusted.customerAccount||'').padStart(10,'0');const allowed=Array.isArray(trusted.allowedSalesDocuments)?trusted.allowedSalesDocuments.map(v=>String(v).padStart(10,'0')):[];const salesDocument=String(request.salesDocument||'').padStart(10,'0');const assurance=String(trusted.identityAssurance||'');const validChannel=['microsoft_teams','whatsapp_business'].includes(channel);const validShape=/^[0-9]{10}$/.test(customerAccount)&&/^[0-9]{10}$/.test(salesDocument)&&subject.length>=6;const authorized=assurance==='VERIFIED_BY_CHANNEL_ADAPTER'&&validChannel&&validShape&&allowed.includes(salesDocument);const denialCode=!validChannel||assurance!=='VERIFIED_BY_CHANNEL_ADAPTER'?'TRUSTED_IDENTITY_REQUIRED':!validShape?'REQUEST_CONTRACT_INVALID':!allowed.includes(salesDocument)?'SALES_DOCUMENT_NOT_AUTHORIZED':null;return [{json:{authorized,denialCode,channel,subjectRef:subject.slice(0,64),customerAccount,salesDocument,requestedAt:new Date().toISOString(),correlationId:String(source.correlationId||('customer-order-'+$execution.id)),responseLanguage:String(request.language||'es').slice(0,5)}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-240, 180],
      "id": "df02517c-8af4-4016-999b-88e3b82c8acc",
      "name": "Authorize Customer Scope"
    },
    {
      "parameters": {
        "options": {},
        "conditions": {
