RFC_GUARD_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RFC_GUARD_MAX_ROWS=50
RFC_GUARD_INACTIVE_DAYS=90
RFC_GUARD_REQUEST_TIMEOUT_SECONDS=30
RFC_GUARD_TLS_KEYSTORE=/run/secrets/sap-rfc-guard-server.p12
RFC_GUARD_TLS_KEYSTORE_PASSWORD=REPLACE_WITH_RANDOM_KEYSTORE_PASSWORD
RFC_GUARD_MODE=read-only
# Provisioning mode belongs in a separate secret/stack only:
# RFC_GUARD_MODE=user-provisioning
# RFC_GUARD_ENABLE_USER_CREATE=true
# RFC_GUARD_USER_PREFIX=N8N_TST_
# RFC_GUARD_USER_GROUP=ZN8N_MOODLE
# RFC_GUARD_USER_VALIDITY_DAYS=7
# RFC_GUARD_NEW_USER_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_INITIAL_PASSWORD
SAP_ASHOST=sap.example.internal
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=REPLACE_WITH_TECHNICAL_USER
SAP_PASSWORD=REPLACE_WITH_TECHNICAL_PASSWORD
SAP_LANG=EN
SAP_POOL_CAPACITY=3
SAP_PEAK_LIMIT=10
# SAP_SNC_MODE=1
# SAP_SNC_PARTNERNAME=p:CN=REPLACE
# SAP_SNC_QOP=3
# SAP_SNC_MYNAME=p:CN=REPLACE
# SAP_SNC_LIB=/opt/sap/snc/libsapcrypto.so
